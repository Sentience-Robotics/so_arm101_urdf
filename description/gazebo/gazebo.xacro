    <joint name="Rotation">
      <param name="virtual_pin">0</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-110</param>
      <param name="servo_max_deg">110</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="Pitch">
      <param name="virtual_pin">1</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-100</param>
      <param name="servo_max_deg">100</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="Elbow">
      <param name="virtual_pin">2</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-100</param>
      <param name="servo_max_deg">90</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="Wrist_Pitch">
      <param name="virtual_pin">3</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-95</param>
      <param name="servo_max_deg">95</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="Wrist_Roll">
      <param name="virtual_pin">4</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-160</param>
      <param name="servo_max_deg">160</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="Jaw">
      <param name="virtual_pin">5</param>
      <param name="servo_type">300</param>
      <param name="offset_deg">0</param>
      <param name="direction">1</param>
      <param name="scale">1</param>
      <param name="servo_min_deg">-10</param>
      <param name="servo_max_deg">100</param>
      <param name="servo_default_deg">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
  </ros2_control>



  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
      <!-- Empty namespace so controller topics stay at /left_arm_controller, /right_arm_controller (panel expects these). -->
      <namespace></namespace>
